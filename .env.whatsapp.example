# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp overdue-lead alerts (Meta WhatsApp Cloud API) — BACKEND ONLY.
# Add these to the Sales Manager backend service's environment (Render → Environment).
# NEVER put these in any frontend / .env that ships to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Company WhatsApp Business sender (from Meta → WhatsApp → API Setup)
WA_PHONE_NUMBER_ID=            # e.g. 123456789012345
WA_ACCESS_TOKEN=              # permanent System User token (keep secret)

# Graph API version — set to a CURRENT, non-EOL version (Meta retires versions ~2 years
# after release; v26.0 reaches end-of-life 24 Sep 2026, so use v27.0 or later after that).
WA_API_VERSION=v23.0

# Approved UTILITY template (create + get approved in Meta first — see WHATSAPP_SETUP.md)
WA_TEMPLATE_NAME=overdue_lead_followup
WA_TEMPLATE_LANG=en

# Secret the external cron must send (header  x-cron-key: <this>  or  ?key=<this>)
WA_CRON_SECRET=               # a long random string

# Default country code for bare 10-digit numbers (India = 91)
WA_DEFAULT_COUNTRY_CODE=91

# Max WhatsApp sends per cron run (0 = unlimited). Spreads a big first batch across runs.
WA_MAX_PER_RUN=50

# OPTIONAL: fallback manager-name -> number map, if you don't store numbers on user records.
# A name listed here is treated as admin-configured (implicit opt-in).
# WA_MANAGER_NUMBERS={"Saravanan":"919845294041","Akash":"919812345678"}
